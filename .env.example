# Copy to `.env` (gitignored) for local debugging, or set these inside your MCP
# client's `env` block. The server reads everything from the environment.

# Required: full ARM resource ID of the target Data Factory.
# Format: /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.DataFactory/factories/<factory>
ADF_FACTORY_RESOURCE_ID=

# Required: Entra (Azure AD) tenant ID the factory lives in.
AZURE_TENANT_ID=

# Optional: client (application) ID used for interactive sign-in.
# Defaults to the Azure CLI public client `04b07795-8ddb-461a-bbee-02f9e1bf7b46`,
# which is fine for most users. Override only if your org requires a custom
# app registration for ARM access.
AZURE_CLIENT_ID=
