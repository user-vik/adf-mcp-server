# Copy to `.env` (gitignored) for local debugging, or set these inside your MCP
# client's `env` block. The server reads everything from the environment.

# ─── Required for all modes ──────────────────────────────────────────────────

# Full ARM resource ID of the target Data Factory.
# Format: /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.DataFactory/factories/<factory>
ADF_FACTORY_RESOURCE_ID=

# ─── Server mode ─────────────────────────────────────────────────────────────

# read  (default) — only the read tools are registered.
# write           — also registers create_pipeline_run, cancel_pipeline_run,
#                   rerun_pipeline_run, start_trigger, stop_trigger.
#                   Every write call is audit-logged to stderr.
ADF_MCP_MODE=read

# ─── Authentication ──────────────────────────────────────────────────────────

# Which credential type to use. One of:
#   interactive       (default) Opens a browser; for desktop devs.
#   device-code       Prints a code + URL to stderr; for SSH/WSL/headless.
#   cli               Uses your existing `az login` session.
#   service-principal Non-interactive, uses CLIENT_ID + CLIENT_SECRET below.
#   managed-identity  For MCP servers hosted on Azure (VM, Container App, etc).
#   default           Tries env → managed-identity → CLI → browser in turn.
ADF_AUTH_MODE=interactive

# Entra (Azure AD) tenant ID.
# Required for: interactive, device-code, service-principal.
# Optional for: cli, managed-identity, default.
AZURE_TENANT_ID=

# Application (client) ID.
# Optional for interactive/device-code (defaults to Azure CLI public client).
# Required for service-principal (the SP's app registration).
# Optional for managed-identity (only for user-assigned MI; omit for system-assigned).
AZURE_CLIENT_ID=

# Client secret for the service principal.
# Required ONLY when ADF_AUTH_MODE=service-principal. Treat as a secret.
AZURE_CLIENT_SECRET=
